# REQUIRED: URL of this merchant simulator (not the VIA FE or Go API).
# Use http://localhost:8000 locally; use your stable HTTPS domain on Vercel.
MERCHANT_PUBLIC_URL=https://your-stable-merchant-domain.example

# REQUIRED, SECRET: RSA private PEM (minimum 2048 bits), generated by setup_local.py.
# Real newlines or literal \n sequences are supported. Never commit the actual key.
JWT_PRIVATE_KEY_PEM=

# REQUIRED, SECRET: stable random cookie-signing secret, generated by setup_local.py.
SESSION_SECRET=

# OPTIONAL: VIA frontend URL to load in the container. Blank permits receiver demo only.
MINIAPP_FRONTEND_URL=

# OPTIONAL: Go API origin/tunnel; used only by tools/smoke_auth.py, not a runtime proxy.
MINIAPP_API_BASE_URL=

# Accounts are in fixtures/demo_users.json, not environment variables.
# Public demo login: demo, demo2 ... demo10 / MuridWukongDemo123!
# Optional overrides (normally leave unset; must match service registration):
# MERCHANT_CODE=murid_wukong_demo
# JWT_ISSUER=<defaults to MERCHANT_PUBLIC_URL>
# JWT_AUDIENCE=bevia-miniapp
# JWT_KEY_ID=murid-wukong-demo-v1
