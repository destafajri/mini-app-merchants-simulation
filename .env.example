# Required for the full login + JWT/JWKS + bridge demo.
# Replace example domains with the stable merchant deployment domain.
# Generate private values with: python tools/setup_local.py
# That helper creates .env and refuses to overwrite an existing .env.

# REQUIRED: URL of this merchant simulator, not the VIA frontend or Go API.
# Must match the browser origin for login/logout/token CSRF checks.
MERCHANT_PUBLIC_URL=https://your-stable-merchant-domain.example

# REQUIRED for token issuance: merchant identity registered in the Go service.
MERCHANT_CODE=murid_wukong_demo

# OPTIONAL until the external VIA frontend is ready: URL loaded in the iframe.
# Blank disables external launch; the built-in receiver demo still works.
MINIAPP_FRONTEND_URL=

# REQUIRED for tokens: exact issuer registered in the Go service.
# Initially use the stable merchant URL; do not change after registration casually.
JWT_ISSUER=https://your-stable-merchant-domain.example

# REQUIRED for tokens: exact audience registered in the Go service.
JWT_AUDIENCE=bevia-miniapp

# REQUIRED for tokens and JWKS: public identifier of the signing key, not a secret.
JWT_KEY_ID=murid-wukong-demo-v1

# REQUIRED for tokens and JWKS; SECRET: RSA private PEM (minimum 2048 bits).
# Generated by setup_local.py. Accepts real newlines or literal \n sequences.
JWT_PRIVATE_KEY_PEM=

# REQUIRED for sessions; SECRET: stable random value shared by all instances.
# Generated by setup_local.py; changing it invalidates existing sessions.
SESSION_SECRET=

# REQUIRED for usable login; SERVER-ONLY: account array including password hashes.
# setup_local.py creates username demo with the password you enter.
# [] is a placeholder with no users, so login cannot succeed until populated.
DEMO_USERS_JSON=[]

# OPTIONAL for the app; required only when running tools/smoke_auth.py.
# Go service origin (or HTTPS tunnel); not used as a frontend API proxy.
MINIAPP_API_BASE_URL=
